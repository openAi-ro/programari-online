                             "supportsTablet":  true,
                             "bundleIdentifier":  "com.programari.app",
                             "buildNumber":  "2",
                             "infoPlist":  {
                                               "ITSAppUsesNonExemptEncryption":  false
                                           }
                         },
                 "android":  {
                                 "package":  "com.programari.app",
                                 "googleServicesFile":  "./google-services.json",
