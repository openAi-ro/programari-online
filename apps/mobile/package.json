{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "2.0.3",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@supabase/supabase-js": "^2.111.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~57.0.21",
    "expo-calendar": "~57.0.5",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "~57.0.17",
    "expo-device": "^57.0.1",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.9",
    "expo-location": "^57.0.18",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-speech-recognition": "~57.1.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-updates": "~57.0.21",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.2",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-maps": "^1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.23.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:safe": "powershell -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1",
    "start:web": "powershell -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Web",
    "start:clear": "powershell -ExecutionPolicy Bypass -File ./scripts/start-expo.ps1 -Clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:slots": "npx tsx lib/slots.test.ts",
    "test:simulate": "npx tsx lib/simulate-e2e.ts",
    "update:preview": "eas update --channel preview --environment preview --non-interactive",
    "update:production": "eas update --channel production --environment production --non-interactive",
    "publish:update": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-update.ps1",
    "build:preview": "powershell -ExecutionPolicy Bypass -File ./scripts/build-preview.ps1 -Profile preview",
    "setup:push": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-push-android.ps1"
  },
  "private": true,
  "allowScripts": {
    "dtrace-provider": "true",
    "protobufjs": "true"
  }
}
