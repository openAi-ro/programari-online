# Copiază în .env și completează valorile din Supabase Dashboard → Settings → API

# Obligatorii pentru app
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Opțional: project URL pentru deep link web (documentare / QR fallback)
# EXPO_PUBLIC_WEB_BASE_URL=https://your-domain.example
