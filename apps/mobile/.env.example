# Copiază în .env și completează valorile din Supabase Dashboard → Settings → API

# Obligatorii pentru app
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# URL public HTTPS (pagina /b/CODE din QR, Instagram, WhatsApp, Stripe return,
# și linkul de activare din email). Nu folosi localhost — emailul trebuie să
# se deschidă de pe telefon. Implicit: https://programari.expo.app
# EXPO_PUBLIC_WEB_BASE_URL=https://programari.expo.app

# Link de instalare APK (QR de pe ecranul de login). Implicit: ultimul build preview Expo.
# EXPO_PUBLIC_INSTALL_URL=https://expo.dev/accounts/promixt/projects/programari/builds/...

# Opțional: avans cu card (Stripe). Fără cheie, avansul se marchează manual (cash/transfer).
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
