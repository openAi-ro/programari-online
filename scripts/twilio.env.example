# Copy to twilio.env (DO NOT commit twilio.env!)
# === Option A (recommended) - Account Info on Twilio console ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# === Option B - API Key (only if using SK..., not AC as token) ===
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your_api_key_secret_here
# WhatsApp From (sandbox or production)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your test handset (must join sandbox first if using sandbox)
TWILIO_WHATSAPP_TO=whatsapp:+40XXXXXXXXX
